---
// src/pages/index.astro
// MODO MUESTRA (temporal): la página principal se ve con un invitado
// ficticio ("Familia Gutiérrez Rojas", 4 pases) para que el cliente vea el
// diseño completo, con el nombre y el pase, antes de conectar el sistema.
//
// Cuando se conecte al panel de invitados (agente `conectar-al-sistema`),
// volver a esta versión:
//
//   import LinkNoDisponible from "../components/LinkNoDisponible.astro";
//   ...
//   <LinkNoDisponible />
//   <Invitacion conectado />
//
// Con `conectado`, el nombre y los pases llegan desde la base (/?i=k7m2p).
import Layout from "../layouts/Layout.astro";
import Invitacion from "../components/Invitacion.astro";
---

<Layout title="Victor & Elva | 18 de Diciembre 2026">
    <Invitacion invitado="Familia Gutiérrez Rojas" pases={4} />
</Layout>
