---
// src/components/Fecha.astro - La invitación a la boda, la fecha grande
// entre el día de la semana y el mes, la cuenta regresiva, el botón para
// agendarla en el calendario, la segunda foto y un mensaje de los novios.
// Los números de la cuenta los llena el script y los actualiza cada segundo.
import Mano from "./Mano.astro";

// ── DATOS EDITABLES ───────────────────────────────────────────
const invitamos = "Tenemos el honor de invitarte a nuestra boda que se realizará el día.";
const diaSemana = "Viernes";
const dia = "18";
const mes = "Diciembre";
const faltan = "Solo Faltan";
// La hora de la boda, con la zona horaria de Bolivia (-04:00)
const fechaBoda = "2026-12-18T15:30:00-04:00";
const foto = "/imagenes/foto2.webp";
const mensaje =
    "Nos haría felices contar con su presencia en este día tan importante, donde juntos celebramos el inicio de nuestra historia como esposos y compartiremos momentos que quedarán para siempre en nuestros corazones.";

// El evento que se agenda en Google Calendar
const evento = {
    titulo: "Boda de Victor y Elva",
    lugar: "Casa Quinta La Floresta, Doble vía La Guardia km 11, Santa Cruz de la Sierra",
    inicio: "20261218T153000",
    fin: "20261218T235900",
    zona: "America/La_Paz",
};
// ──────────────────────────────────────────────────────────────

const agendar =
    "https://calendar.google.com/calendar/render?action=TEMPLATE" +
    `&text=${encodeURIComponent(evento.titulo)}` +
    `&dates=${evento.inicio}/${evento.fin}` +
    `&ctz=${encodeURIComponent(evento.zona)}` +
    `&location=${encodeURIComponent(evento.lugar)}`;

const unidades = [
    { clave: "dias", rotulo: "Días" },
    { clave: "horas", rotulo: "Horas" },
    { clave: "min", rotulo: "Min." },
    { clave: "seg", rotulo: "Seg." },
];
---

<section class="inv-seccion fecha" id="fecha-boda">
    <img src="/imagenes/flor-esquina.webp" alt="" width="382" height="692" class="inv-flor flor-der" aria-hidden="true" />
    <img src="/imagenes/flor-lateral.webp" alt="" width="360" height="749" class="inv-flor inv-flor-espejo flor-izq" aria-hidden="true" />

    <p class="inv-texto invitamos anima">{invitamos}</p>

    <svg class="inv-corazon anima" viewBox="0 0 24 24" aria-hidden="true">
        <path fill="currentColor" d="M12 21s-7.5-4.7-9.7-9A5.4 5.4 0 0 1 12 6.3 5.4 5.4 0 0 1 21.7 12c-2.2 4.3-9.7 9-9.7 9z"></path>
    </svg>

    <div class="dia-fila anima">
        <span class="lado">{diaSemana}</span>
        <span class="dia">{dia}</span>
        <span class="lado">{mes}</span>
    </div>

    <p class="inv-texto faltan anima">{faltan}</p>

    <div class="cuenta-marco anima">
        <span class="filete" aria-hidden="true"><i></i></span>
        <div class="cuenta" id="cuenta-boda" data-fecha={fechaBoda}>
            {
                unidades.map((u, i) => (
                    <>
                        {i > 0 && <span class="dos-puntos" aria-hidden="true">:</span>}
                        <div class="unidad">
                            <span class="numero" data-unidad={u.clave}>00</span>
                            <span class="rotulo">{u.rotulo}</span>
                        </div>
                    </>
                ))
            }
        </div>
        <span class="filete" aria-hidden="true"><i></i></span>
    </div>

    {/* Botón "Agendar en el calendario": desactivado por ahora. Si los
        novios lo quieren, quitar este comentario (el enlace de Google
        Calendar ya está armado arriba, en "agendar").
    <div class="agendar anima">
        <div class="inv-boton-fila">
            <a class="inv-boton inv-boton-borde" href={agendar} target="_blank" rel="noopener noreferrer">
                <svg class="calendario" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="4.5" width="18" height="16.5" rx="1.5"></rect>
                    <path d="M3 9h18M8 2.8v3.4M16 2.8v3.4"></path>
                    <path d="M12 18.2s-3.4-2.1-3.4-4.3a1.8 1.8 0 0 1 3.4-.8 1.8 1.8 0 0 1 3.4.8c0 2.2-3.4 4.3-3.4 4.3z"></path>
                </svg>
                Agendar en el calendario
            </a>
            <Mano />
        </div>
    </div>
    */}

    <img src={foto} alt="Los novios" width="860" height="1290" class="inv-foto foto anima" loading="lazy" />

    <p class="inv-texto mensaje anima">{mensaje}</p>
</section>

<style>
    .fecha {
        padding-top: 6cqw;
        padding-left: 0;
        padding-right: 0;
    }

    .fecha > :not(.inv-flor, .foto) {
        margin-left: 8cqw;
        margin-right: 8cqw;
    }

    .flor-der {
        top: 2cqw;
        right: -8cqw;
        width: 22cqw;
    }

    .flor-izq {
        top: 34cqw;
        left: -10cqw;
        width: 20cqw;
    }

    /* Centrados: la regla de los márgenes de arriba no les corresponde */
    .fecha > .inv-corazon {
        margin-left: auto;
        margin-right: auto;
    }

    /* El corazón late: dos golpecitos suaves (como un latido de verdad),
       un descanso, y un brillo dorado que se enciende con cada golpe.
       Va con "scale" y no con "transform" para no chocar con la entrada
       de GSAP, que mueve el mismo elemento */
    @media (prefers-reduced-motion: no-preference) {
        .fecha > .inv-corazon {
            animation: latido 1.8s ease-in-out infinite;
            transform-origin: center;
        }
    }

    @keyframes latido {
        0%,
        45%,
        100% {
            scale: 1;
            filter: drop-shadow(0 0 0 rgba(195, 146, 47, 0));
        }
        12% {
            scale: 1.16;
            filter: drop-shadow(0 0 1.6cqw rgba(195, 146, 47, 0.55));
        }
        22% {
            scale: 1.02;
        }
        32% {
            scale: 1.12;
            filter: drop-shadow(0 0 1.2cqw rgba(195, 146, 47, 0.4));
        }
    }

    .invitamos {
        font-size: 4.6cqw;
    }

    /* Viernes · 18 · Diciembre, los costados entre dos filetes */
    .dia-fila {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 4cqw;
        margin-left: 2cqw !important;
        margin-right: 2cqw !important;
    }

    .lado {
        padding: 1.6cqw 0;
        border-top: 1px solid #55625a;
        border-bottom: 1px solid #55625a;
        font-weight: 400;
        font-size: 5cqw;
        text-transform: uppercase;
        color: var(--verde-gris);
    }

    .dia {
        font-family: "Cormorant Garamond", serif;
        font-weight: 500;
        font-size: 24cqw;
        line-height: 1;
        /* La Cormorant trae números antiguos ("ı8"): estos van parejos */
        font-variant-numeric: lining-nums;
        color: var(--oro);
    }

    .faltan {
        margin-top: 6cqw;
        font-size: 4.4cqw;
    }

    .cuenta-marco {
        margin-top: 2cqw;
    }

    /* Filete dorado con un rombito al medio */
    .filete {
        position: relative;
        display: block;
        height: 2cqw;
        margin: 0 6cqw;
    }

    .filete::before {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        top: 50%;
        height: 1px;
        background-image: linear-gradient(90deg, transparent, var(--oro) 20%, var(--oro) 80%, transparent);
    }

    .filete i {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 1.6cqw;
        height: 1.6cqw;
        border: 1px solid var(--oro);
        background-image: linear-gradient(#fff, #fff);
        transform: translate(-50%, -50%) rotate(45deg);
    }

    .cuenta {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        gap: 1.5cqw;
        padding: 2cqw 0 1.5cqw;
    }

    .unidad {
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: 15cqw;
    }

    .numero,
    .dos-puntos {
        font-weight: 500;
        font-size: 11.5cqw;
        line-height: 1;
        color: var(--oro);
        font-variant-numeric: tabular-nums;
    }

    .rotulo {
        margin-top: 1.5cqw;
        font-size: 3.2cqw;
    }

    .agendar {
        margin-top: 8cqw;
    }

    .calendario {
        width: 6.5cqw;
        height: 6.5cqw;
        color: var(--oliva);
    }

    .agendar :global(.inv-mano) {
        margin-top: 8cqw;
    }

    .foto {
        margin-top: 10cqw;
    }

    .mensaje {
        margin-top: 12cqw;
        font-size: 4.2cqw;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const cuenta = document.getElementById("cuenta-boda");
        if (!cuenta) return;

        const destino = new Date(cuenta.dataset.fecha ?? "").getTime();
        const campos: Record<string, HTMLElement | null> = {};
        for (const clave of ["dias", "horas", "min", "seg"]) {
            campos[clave] = cuenta.querySelector(`[data-unidad="${clave}"]`);
        }
        const dos = (n: number) => String(n).padStart(2, "0");

        const actualizar = () => {
            const resta = Math.max(0, destino - Date.now());
            const s = Math.floor(resta / 1000);
            const valores: Record<string, number> = {
                dias: Math.floor(s / 86400),
                horas: Math.floor((s % 86400) / 3600),
                min: Math.floor((s % 3600) / 60),
                seg: s % 60,
            };
            for (const clave in valores) {
                const el = campos[clave];
                // Los días van sin cero adelante, como en el diseño
                const texto = clave === "dias" ? String(valores[clave]) : dos(valores[clave]);
                if (el && el.textContent !== texto) el.textContent = texto;
            }
            return resta > 0;
        };

        if (!isNaN(destino) && actualizar()) {
            const reloj = setInterval(() => {
                if (!actualizar()) clearInterval(reloj);
            }, 1000);
        }
    });
</script>
