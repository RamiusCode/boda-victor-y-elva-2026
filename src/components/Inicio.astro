---
// src/components/Inicio.astro - Lo primero que se ve al abrir la portada:
// el logo de los novios, el versículo y la primera foto, que se
// funde con el blanco. (La música la arranca la portada al abrirse.)
// El id "sobre-novios" es a donde baja la portada al abrirse.

// ── DATOS EDITABLES ───────────────────────────────────────────
const versiculo = "El amor no pasará jamás.";
const cita = "1 Corintios 13:8";
const foto = "/imagenes/pareja-08.webp";
// ──────────────────────────────────────────────────────────────
---

<section id="sobre-novios" class="inv-seccion inicio">
    <img src="/imagenes/flor-lateral.webp" alt="" width="360" height="749" class="inv-flor flor-izq" aria-hidden="true" />
    <img src="/imagenes/flor-lateral.webp" alt="" width="360" height="749" class="inv-flor inv-flor-espejo flor-der" aria-hidden="true" />

    <!-- El logo de los novios, arriba del versículo -->
    <img src="/imagenes/logo2.webp" alt="Victor y Elva" width="420" height="384" class="logo anima" />

    <p class="inv-texto versiculo anima">
        {versiculo}<br />
        <span class="cita">{cita}</span>
    </p>

    <img src={foto} alt="Los novios" width="860" height="1290" class="inv-foto foto anima" fetchpriority="high" />
</section>

<style>
    .inicio {
        padding-top: 16cqw;
        padding-bottom: 0;
        padding-left: 0;
        padding-right: 0;
    }

    .flor-izq,
    .flor-der {
        top: 2cqw;
        width: 30cqw;
    }

    .flor-izq {
        left: -12cqw;
    }

    .flor-der {
        right: -12cqw;
    }

    .logo {
        display: block;
        width: 34cqw;
        height: auto;
        margin: 0 auto;
        user-select: none;
        -webkit-user-drag: none;
    }

    .versiculo {
        max-width: 66cqw;
        margin: 9cqw auto 0;
        font-size: 5cqw;
        line-height: 1.5;
        color: var(--verde);
    }

    .cita {
        display: inline-block;
        margin-top: 3cqw;
        font-size: 0.9em;
        color: var(--oro);
    }

    .foto {
        margin-top: 6cqw;
    }
</style>

<script>
    import { gsap } from "gsap";

    document.addEventListener("DOMContentLoaded", () => {
        const seccion = document.getElementById("sobre-novios");
        if (!seccion) return;

        // La portada dispara la entrada del logo, las flores y el reproductor
        // a la vez. El versículo y la foto siguen con un pequeño desfase suave.
        const flores = seccion.querySelectorAll(".flor-izq, .flor-der");
        const logo = seccion.querySelector<HTMLElement>(".logo");
        const contenido = seccion.querySelectorAll(".versiculo, .foto");
        const elementos = [...Array.from(flores), ...(logo ? [logo] : []), ...Array.from(contenido)];
        gsap.set(elementos, { opacity: 0 });

        const entrar = () => {
            const menos = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            const duracion = menos ? 0.45 : 0.95;
            const tl = gsap.timeline();

            tl.fromTo(flores, { opacity: 0 }, { opacity: 1, duration: duracion, ease: "sine.out" }, 0)
                .fromTo(
                    logo,
                    { opacity: 0, y: menos ? 0 : 12, scale: menos ? 1 : 0.97 },
                    { opacity: 1, y: 0, scale: 1, duration: duracion, ease: "sine.out" },
                    0,
                )
                .fromTo(
                    contenido,
                    { opacity: 0, y: menos ? 0 : 12 },
                    { opacity: 1, y: 0, duration: menos ? 0.45 : 0.82, stagger: 0.12, ease: "sine.out" },
                    menos ? 0 : 0.14,
                );
        };
        if ((window as any).portadaAbierta) entrar();
        else window.addEventListener("portada-abierta", entrar, { once: true });
    });
</script>
