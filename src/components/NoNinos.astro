---
// src/components/NoNinos.astro - Aviso de que la celebración es solo para
// adultos: título dorado y una línea en negrita, con el mismo estilo del
// resto de las secciones.

// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "No niños 👶";
const aviso = "Exclusiva para adultos";
// ──────────────────────────────────────────────────────────────
---

<section class="inv-seccion no-ninos">
    <img src="/imagenes/flor-esquina.webp" alt="" width="382" height="692" class="inv-flor flor-der" aria-hidden="true" />

    <h2 class="inv-titulo anima">{titulo}</h2>

    <p class="inv-texto aviso anima">{aviso}</p>
</section>

<style>
    .no-ninos {
        padding-top: 14cqw;
        padding-bottom: 8cqw;
    }

    .flor-der {
        bottom: -8cqw;
        right: -8cqw;
        width: 22cqw;
    }

    .aviso {
        margin: 5cqw 0 0;
        font-weight: 700;
        font-size: 5cqw;
    }
</style>
