---
// src/components/Padrinos.astro - Los padrinos de religión y de civil, en
// dos columnas.

// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "Nuestros padrinos";
const grupos = [
    {
        titulo: "Padrinos de religión",
        nombres: ["Gonzalo Guerrero Serrudo", "Susana Alicia Gomez"],
    },
    {
        titulo: "Padrinos de civil",
        nombres: ["Santos Daniel Ovando Soliz", "Selena Torrico Choque"],
    },
];
// ──────────────────────────────────────────────────────────────
---

<section class="inv-seccion padrinos">
    <h2 class="titulo anima">{titulo}</h2>

    <div class="columnas anima">
        {
            grupos.map((g) => (
                <div>
                    <p class="rotulo">{g.titulo}</p>
                    {g.nombres.map((nombre) => (
                        <p class="nombre">{nombre}</p>
                    ))}
                </div>
            ))
        }
    </div>
</section>

<style>
    .padrinos {
        padding-top: 4cqw;
        padding-left: 4cqw;
        padding-right: 4cqw;
    }

    .titulo {
        margin: 0;
        font-weight: 500;
        font-size: 4.6cqw;
        text-transform: uppercase;
        color: var(--texto);
    }

    .columnas {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3cqw;
        margin-top: 5cqw;
    }

    .rotulo {
        margin: 0 0 1cqw;
        font-weight: 700;
        font-size: 3.4cqw;
        text-transform: uppercase;
        color: var(--oro);
    }

    .nombre {
        margin: 0;
        font-size: 3.4cqw;
        line-height: 1.5;
    }
</style>
