---
// src/components/Vestimenta.astro - El código de vestimenta: título dorado,
// un círculo fino con el traje y el vestido (dibujos dorados), y la aclaración.

// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "Código de vestimenta";
const codigo = "Formal";
const aclaracion = "No asistir con blanco, beige y rojo";
// ──────────────────────────────────────────────────────────────
---

<section class="inv-seccion vestimenta">
    <img src="/imagenes/flor-esquina.webp" alt="" width="382" height="692" class="inv-flor flor-der" aria-hidden="true" />
    <img src="/imagenes/flor-lateral.webp" alt="" width="360" height="749" class="inv-flor flor-izq" aria-hidden="true" />

    <h2 class="inv-titulo anima">{titulo}</h2>

    <div class="circulo anima" aria-hidden="true">
        <img src="/imagenes/traje-hombre.webp" alt="" width="126" height="300" class="icono" />
        <img src="/imagenes/traje-mujer.webp" alt="" width="237" height="300" class="icono" />
    </div>

    <p class="inv-texto codigo anima">{codigo}</p>
    <p class="inv-texto aclaracion anima">{aclaracion}</p>

</section>

<style>
    .vestimenta {
        padding-top: 16cqw;
    }

    .flor-der {
        top: 50cqw;
        right: -8cqw;
        width: 20cqw;
    }

    .flor-izq {
        bottom: -6cqw;
        left: -12cqw;
        width: 22cqw;
    }

    /* Título más chico que el de las otras secciones */
    .vestimenta .inv-titulo {
        font-size: 5.8cqw;
    }

    .circulo {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5cqw;
        width: 66cqw;
        height: 66cqw;
        margin: 8cqw auto 0;
        border: 1px solid #d8bf63;
        border-radius: 50%;
        color: #5b6e53;
    }

    .icono {
        height: 36cqw;
        width: auto;
        user-select: none;
        -webkit-user-drag: none;
    }

    /* Como la referencia: el código en mayúsculas, más grande y liviano;
       la aclaración debajo, en negrita y entre paréntesis */
    .codigo {
        margin-top: 8cqw;
        font-weight: 500;
        font-size: 6.4cqw;
        text-transform: uppercase;
        color: var(--texto);
    }

    .aclaracion {
        max-width: 78cqw;
        margin: 3cqw auto 0;
        font-weight: 700;
        font-size: 4.4cqw;
        line-height: 1.5;
    }

</style>
