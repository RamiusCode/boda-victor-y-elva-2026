---
// src/components/AlbumFotos.astro - "Álbum de fotos": una foto grande y un
// collage de cinco debajo (dos chicas, una ancha y otras dos chicas).
// Por ahora todas llevan la misma foto de muestra: cuando lleguen las de los
// novios se cambian en la lista `fotos` (en el orden en que aparecen).

// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "Álbum de fotos";
const muestra = "/imagenes/foto1.webp";
const fotos = {
    grande: muestra,
    collage: [muestra, muestra, muestra, muestra, muestra],
};
// ──────────────────────────────────────────────────────────────
---

<section class="inv-seccion album">
    <h2 class="inv-titulo anima">{titulo}</h2>

    <img src={fotos.grande} alt="Los novios" width="860" height="1290" class="foto grande anima" loading="lazy" />

    <div class="collage">
        {
            fotos.collage.map((src, i) => (
                <img
                    src={src}
                    alt="Los novios"
                    width="860"
                    height="1290"
                    class={`foto f${i + 1} anima`}
                    loading="lazy"
                />
            ))
        }
    </div>
</section>

<style>
    .album {
        padding-top: 6cqw;
        padding-bottom: 14cqw;
        padding-left: 6cqw;
        padding-right: 6cqw;
    }

    .foto {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        user-select: none;
        -webkit-user-drag: none;
    }

    .grande {
        height: auto;
        aspect-ratio: 5 / 6;
        margin-top: 8cqw;
    }

    .collage {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2cqw;
        margin-top: 7cqw;
    }

    /* Dos chicas, una ancha, otras dos chicas */
    .f1,
    .f2 {
        aspect-ratio: 215 / 235;
    }

    .f3 {
        grid-column: 1 / -1;
        aspect-ratio: 440 / 345;
    }

    .f4,
    .f5 {
        aspect-ratio: 215 / 352;
    }
</style>
