---
// src/components/AlbumFotos.astro - "Álbum de fotos": una foto grande y un
// collage de cinco debajo (dos chicas, una ancha y otras dos chicas).
// Fotos de la pareja y su perrito, optimizadas en WebP de alta calidad.

// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "Álbum de fotos";
const fotos = {
    grande: { src: "/imagenes/pareja-02.webp", alt: "Victor y Elva caminando juntos" },
    collage: [
        { src: "/imagenes/pareja-04.webp", alt: "Victor y Elva sentados juntos en el jardín" },
        { src: "/imagenes/pareja-03.webp", alt: "Victor y Elva abrazados" },
        { src: "/imagenes/pareja-09.webp", alt: "Victor y Elva en la sesión de fotos" },
        { src: "/imagenes/pareja-06.webp", alt: "Victor y Elva juntos frente a la capilla" },
        { src: "/imagenes/pareja-05.webp", alt: "Victor y Elva compartiendo un momento especial" },
        { src: "/imagenes/pareja-10.webp", alt: "El perrito de Victor y Elva en el jardín" },
    ],
};
// ──────────────────────────────────────────────────────────────
---

<section class="inv-seccion album">
    <h2 class="inv-titulo anima">{titulo}</h2>

    <img src={fotos.grande.src} alt={fotos.grande.alt} width="860" height="1290" class="foto grande anima" loading="lazy" />

    <div class="collage">
        {
            fotos.collage.map((foto, i) => (
                <img
                    src={foto.src}
                    alt={foto.alt}
                    width="860"
                    height="1290"
                    class={`foto f${i + 1} anima`}
                    loading="lazy"
                />
            ))
        }
    </div>
</section>

<style>
    .album {
        padding-top: 6cqw;
        padding-bottom: 14cqw;
        padding-left: 6cqw;
        padding-right: 6cqw;
    }

    .foto {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        user-select: none;
        -webkit-user-drag: none;
    }

    .grande {
        height: auto;
        aspect-ratio: 5 / 6;
        margin-top: 8cqw;
    }

    .collage {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2cqw;
        margin-top: 7cqw;
    }

    /* Dos chicas, una ancha, otras dos chicas */
    .f1,
    .f2 {
        aspect-ratio: 215 / 235;
    }

    .f3 {
        grid-column: 1 / -1;
        aspect-ratio: 440 / 345;
    }

    .f4,
    .f5 {
        aspect-ratio: 215 / 352;
    }

    .f6 {
        grid-column: 1 / -1;
        aspect-ratio: 2 / 3;
    }
</style>
