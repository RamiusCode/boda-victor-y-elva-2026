---
// Calendario de diciembre de 2026; destaca el día de la boda.
const anio = 2026;
const mes = "Diciembre";
const diaBoda = 18;
const etiquetas = ["D", "L", "M", "M", "J", "V", "S"];
const inicioMes = new Date(anio, 11, 1).getDay();
const cantidadDias = new Date(anio, 12, 0).getDate();
const celdas = Array.from({ length: 35 }, (_, indice) => {
    const numero = indice - inicioMes + 1;
    return numero > 0 && numero <= cantidadDias ? numero : null;
});
---

<div class="calendario-seccion" aria-label={`Calendario de ${mes} de ${anio}`}>
    <img src="/imagenes/flor-lateral.webp" alt="" class="hojas hojas-izq" aria-hidden="true" />
    <img src="/imagenes/flor-lateral.webp" alt="" class="hojas hojas-der" aria-hidden="true" />

    <div class="calendario-card anima">
        <div class="titulo-mes">
            <span class="linea" aria-hidden="true"></span>
            <h3 id="titulo-calendario">{mes} {anio}</h3>
            <span class="linea" aria-hidden="true"></span>
        </div>

        <div class="dias-semana" role="row">
            {etiquetas.map((etiqueta) => <span role="columnheader">{etiqueta}</span>)}
        </div>

        <div class="dias-grid" role="grid" aria-labelledby="titulo-calendario">
            {celdas.map((numero) => (
                <span
                    class:list={["celda-dia", numero === diaBoda && "dia-boda"]}
                    role="gridcell"
                    aria-label={numero === diaBoda ? `${numero} de ${mes}, día de la boda` : numero ? `${numero} de ${mes}` : undefined}
                    aria-hidden={numero === null ? "true" : undefined}
                >
                    {numero ?? ""}
                </span>
            ))}
        </div>
    </div>
</div>

<style>
    .calendario-seccion {
        position: relative;
        isolation: isolate;
        margin: 8cqw 0 2cqw;
        padding: 3cqw 0;
    }

    .hojas {
        position: absolute;
        z-index: -1;
        top: 24%;
        width: 25cqw;
        height: auto;
        opacity: 0.58;
        pointer-events: none;
    }

    .hojas-izq {
        left: -12cqw;
    }

    .hojas-der {
        right: -12cqw;
        transform: scaleX(-1);
    }

    .calendario-card {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 86cqw;
        margin: 0 auto;
        padding: 6cqw 5cqw 5cqw;
        border: 1px solid var(--oro-suave);
        border-radius: 4cqw;
        background: rgba(255, 253, 248, 0.82);
        box-shadow: 0 4px 14px rgba(91, 110, 83, 0.1);
    }

    .titulo-mes {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 3cqw;
        margin-bottom: 5cqw;
    }

    .titulo-mes h3 {
        margin: 0;
        color: var(--oro);
        font-family: "Cormorant Garamond", serif;
        font-size: 9cqw;
        font-weight: 500;
        line-height: 1;
        text-align: center;
    }

    .linea {
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--oro));
    }

    .linea:last-child {
        transform: scaleX(-1);
    }

    .dias-semana,
    .dias-grid {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 1cqw;
    }

    .dias-semana {
        margin-bottom: 2cqw;
        color: var(--verde-gris);
        font-family: "Quicksand", sans-serif;
        font-size: 4cqw;
        font-weight: 700;
        text-align: center;
    }

    .celda-dia {
        display: grid;
        aspect-ratio: 1;
        place-items: center;
        border-radius: 2cqw;
        color: var(--texto);
        font-family: "Quicksand", sans-serif;
        font-size: 4.2cqw;
        font-variant-numeric: tabular-nums;
        transition: background-color 180ms ease, transform 180ms ease;
    }

    .celda-dia:not(:empty):hover {
        transform: translateY(-1px);
        background: rgba(190, 158, 55, 0.12);
    }

    .dia-boda {
        border-radius: 50%;
        background: linear-gradient(145deg, var(--oro), var(--oro-suave));
        box-shadow: 0 4px 12px rgba(190, 158, 55, 0.28);
        color: #fff;
        font-size: 5cqw;
        font-weight: 700;
    }
</style>
